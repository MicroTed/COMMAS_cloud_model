#!/usr/bin/env python3
#
# System imports
#
#=======================================================================
#
#
#  Python Makefile-thing for COMMAS
#
#
#=======================================================================

import sys, os
import platform

RANLIB = "'ranlib'"
AR     = "'ar -ru'"
MAKE   = 'make -f ../src/Makefile' # --debug'
#MAKE   = 'make -f Makefile.tmp' # --debug'

# define less-used options as null
OPT_BUOY = "''"
OPT_SLV  = "''"
OPT_ADV  = "''"

#=======================================================================
#
#
# Function to do the makefile calls

def makeit(current_dir,makefile_dir,target,compile_options,mpisuf):

	print("Change directory to " + makefile_dir)

	if os.path.exists(makefile_dir):
		os.chdir(makefile_dir)
	else:
		print("ERROR!!! ")
		print("ERROR!!! Build directory does not exist, so will create it: " + makefile_dir)
		print("ERROR!!! ")
		os.system('mkdir ' + makefile_dir)
		os.chdir(makefile_dir)

	print()
	print("Making " + target)

	MAKE_CMD = MAKE + " " + target + " " + compile_options

	if os.system(MAKE_CMD) != 0:
		print()
		print("ERROR!!! ")
		print("ERROR!!!  Failed to compile " + target)
		print("ERROR!!! ")
		print()
		os.chdir(current_dir)
		return 0

	print("Finished compiling " + target)

	LINK_CMD = 'ln -s ' + makefile_dir + '/' + target + ' ' + current_dir + '/' + target + mpisuf

	if os.system(LINK_CMD) != 0:
		print()
		print("ERROR!!! ")
		print("ERROR!!!  Failed to link " + target)
		print("ERROR!!! ")
		print()
		os.chdir(current_dir)
		return 0

	print("Linking " + target + " to main directory")

	print()
	os.chdir(current_dir)

	return 1
