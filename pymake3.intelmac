#=======================================================================
# main script

# Figure out which machine we are on

machine = platform.machine()  # i386, ppc, etc.
system  = platform.system()   # Darwin, Linux,
compiler = "ifort"
mpi    = 'no'
SOURCE = 'src'
mpisuf = ''

# mpisuf = ''
