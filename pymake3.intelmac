	NETCDF_INC = "'-I/opt/local/netcdf4/include -I/usr/local/hdf5/include'"
	LIB        = "''"

#-------------------------------------------------------------------------
#
FCOMPILE       = 'F90=' + F90 + ' F77=' + F77 + ' FPP=' + FPP + ' CC=' + CC + ' FIXED=' + FIXED + ' FREE=' + FREE  \
               + ' OPT_F90=' + OPT_F90 + ' OPT_F77=' + OPT_F77 + ' SMP=' + SMP + ' PAR=' + ' CFLAGS=' + CFLAGS     \
               + ' GRDOPT=' + GRDOPT + ' MOPT4=' + MOPT4 + ' MOPT5=' + MOPT5 + ' OPT_ADV=' + OPT_ADV               \
               + ' SOROPT=' + SOROPT + ' OPT_BUOY=' + OPT_BUOY + ' FPPDEF=' + FPPDEF + ' IPO=' + IPO + ' AR=' + AR \
               + ' OPT_SLV=' + OPT_SLV + ' LDR=' + LDR +  ' LOPT=' + LOPT + ' LIB=' + LIB                          \
               + ' NETCDF_LIB=' + NETCDF_LIB + ' NETCDF_INC=' + NETCDF_INC                                         \
               + ' AR=' + AR + ' RANLIB=' + RANLIB + ' NCARGF=' + NCARGF + ' DFLAGS=' + DFLAGS

#--------------------------------------------------------------------------
# COMPILE DICTIONARY
#                 name           location    target         compile options
#--------------------------------------------------------------------------
#MAKE_DICT      = {'fort_lib':    ['./srcmpi', 'obj',     FCOMPILE], \

MAKE_DICT      = {'commas':      ['./build'+mpisuf, 'commas' ,     FCOMPILE], \
#                  'commas_init': ['./build'+mpisuf, 'commas_init', FCOMPILE], \
                  'com2v5d':     ['./build'+mpisuf, 'com2v5d',     FCOMPILE], \
                  'com2nc4':     ['./build'+mpisuf, 'com2nc4',     FCOMPILE]}

MAKE_DICT_HCM   = {'commashcm':      ['./build'+mpisuf, 'commashcm' ,     FCOMPILE]}

MAKE_DICT_TAK   = {'commastak':      ['./build'+mpisuf, 'commastak' ,     FCOMPILE]}

MAKE_DICT_TAKSPEC = {'comspectra':      ['./build'+mpisuf, 'comspectra' ,     FCOMPILE]}

MAKE_DICT_PLOT   = {'complot':      ['./build'+mpisuf, 'complot' ,     FCOMPILE]}

MAKE_DICT_MAXMIN   = {'maxmin':      ['./build'+mpisuf, 'maxmin' ,     FCOMPILE]}

MAKE_DICT_GRADS  = {'com2grads':      ['./build'+mpisuf, 'com2grads' ,     FCOMPILE]}

MAKE_DICT_TRAJ  = {'comtraj':      ['./build'+mpisuf, 'comtraj' ,     FCOMPILE]}

MAKE_DICT_COMB   = {'combine':      ['./build'+mpisuf, 'combine' ,     FCOMPILE]}

MAKE_DICT_TRMM   = {'comtrmm':      ['./build'+mpisuf, 'comtrmm' ,     FCOMPILE]}

#, \
#                  'filter':      ['./Filter','enkf',        FCOMPILE]}

current_dir = os.getcwd()

if len(sys.argv) == 1:
	print()
	print("No argument! Use 'pymake help' for list of options")
	print()
	print("Assuming 'all' - compiling all!")
	sys.argv.append('all')

if len(sys.argv) > 1:

	print("User argument:  ", sys.argv[1])

	if sys.argv[1] == 'clean':
		print()
		print("Cleaning directory")

		targets = list(MAKE_DICT.keys())

		tmp = MAKE_DICT['commas']
		os.chdir(tmp[0])
		os.system(MAKE + " clean")
		os.chdir("..")

		for key in targets:
			tmp = MAKE_DICT[key]
			os.system("rm " + tmp[1] + mpisuf)
#			os.chdir(tmp[0])
#			os.system(MAKE + " clean")
#			os.system("cd " + current_dir)
			print("Cleaned up ", tmp[1])


	if sys.argv[1] == 'all':
		targets = list(MAKE_DICT.keys())
		for key in targets:
			tmp = MAKE_DICT[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'commashcm':
		targets = list(MAKE_DICT_HCM.keys())
		for key in targets:
			tmp = MAKE_DICT_HCM[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'commastak':
		targets = list(MAKE_DICT_TAK.keys())
		for key in targets:
			tmp = MAKE_DICT_TAK[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'comspectra':
		targets = list(MAKE_DICT_TAKSPEC.keys())
		for key in targets:
			tmp = MAKE_DICT_TAKSPEC[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'complot':
		targets = list(MAKE_DICT_PLOT.keys())
		for key in targets:
			tmp = MAKE_DICT_PLOT[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'maxmin':
		targets = list(MAKE_DICT_MAXMIN.keys())
		for key in targets:
			tmp = MAKE_DICT_MAXMIN[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'com2grads':
		targets = list(MAKE_DICT_GRADS.keys())
		for key in targets:
			tmp = MAKE_DICT_GRADS[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'comtraj':
		targets = list(MAKE_DICT_TRAJ.keys())
		for key in targets:
			tmp = MAKE_DICT_TRAJ[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'combine':
		targets = list(MAKE_DICT_COMB.keys())
		for key in targets:
			tmp = MAKE_DICT_COMB[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'comtrmm':
		targets = list(MAKE_DICT_TRMM.keys())
		for key in targets:
			tmp = MAKE_DICT_TRMM[key]
			os.system("rm " + tmp[1] + mpisuf)
			ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] in MAKE_DICT:
		tmp = MAKE_DICT[sys.argv[1]]
		os.system("rm " + tmp[1] + mpisuf)
		ret = makeit(current_dir,tmp[0],tmp[1],tmp[2],mpisuf)

	if sys.argv[1] == 'help':

		print("==============================================================================================")
		print("                        Python Compile Script for PyEnCOMMAS ")
		print()
		print("     pymake all  --> To create a running version of PyEnCOMMAS: ")
		print("                      this creates the commas solver library and python interface routines ")
		print("                      so one can run the scripts. ")
		print()
		print("     pymake com2v5d --> To create the COMMAS to Vis5D conversion program")
		print()
		print("     pymake clean  --> cleans up the directory, removing object and module files  ")
		print()
		print("==============================================================================================")
